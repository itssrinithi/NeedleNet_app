<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#1C274C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Details"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1C274C"
                android:gravity="center"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- Order ID & Status -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order #ORD-2024-0127"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1C274C"
                        android:layout_weight="1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="#FFEEF0"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:gravity="center"
                        android:text="Pending"
                        android:textColor="#FF2B52"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="January 27, 2024"
                    android:textSize="15sp"
                    android:textColor="#7A8699"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Garment Types -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Garment Types"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:layout_width="110dp" android:layout_height="40dp" android:text="Formal Suit" android:textAllCaps="false" android:textStyle="bold" android:textColor="#fff" android:backgroundTint="#FF2B52" app:cornerRadius="22dp" android:layout_marginEnd="8dp"/>
                    <Button android:layout_width="110dp" android:layout_height="40dp" android:text="Dress Shirt" android:textAllCaps="false" android:textColor="#fff" android:backgroundTint="#FF2B52" app:cornerRadius="22dp" android:layout_marginEnd="8dp"/>
                    <Button android:layout_width="110dp" android:layout_height="40dp" android:text="Trousers" android:textAllCaps="false" android:textColor="#fff" android:backgroundTint="#FF2B52" app:cornerRadius="22dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Description -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Three-piece formal suit in navy blue with peak lapels. Modern fit with single-breasted styling. Looking for a classic yet contemporary design with attention to detail in the construction."
                    android:textSize="15sp"
                    android:textColor="#343C56"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Measurements -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Measurements"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Standard Size"
                        android:textSize="15sp"
                        android:textColor="#343C56"
                        android:layout_weight="1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="15sp"
                        android:textColor="#343C56"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Reference Cloth for measurements"
                        android:textSize="15sp"
                        android:textColor="#343C56"
                        android:layout_weight="1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Provided"
                        android:textSize="15sp"
                        android:textColor="#21C274"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual Measurements"
                    android:textSize="15sp"
                    android:textColor="#343C56"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:text="Shoulder: 42\"" 
                        android:textSize="15sp" 
                        android:textColor="#343C56" 
                        android:layout_weight="1" />
                    <TextView 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="Chest: 44\"" 
                        android:textSize="15sp" 
                        android:textColor="#343C56" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView 
                        android:layout_width="0dp" 
                        android:layout_height="wrap_content" 
                        android:text="Waist: 36\"" 
                        android:textSize="15sp" 
                        android:textColor="#343C56" 
                        android:layout_weight="1" />
                    <TextView 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="Hip: 40\"" 
                        android:textSize="15sp" 
                        android:textColor="#343C56" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Reference Images -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reference Images"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"
                    android:layout_marginBottom="8dp"/>
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:alignmentMode="alignMargins"
                    android:rowOrderPreserved="false">
                    <!-- Use ImageViews to show actual images from backend -->
                    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/img_24" android:scaleType="centerCrop" android:layout_margin="4dp"/>
                    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/img_22" android:scaleType="centerCrop" android:layout_margin="4dp"/>
                    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/img_21" android:scaleType="centerCrop" android:layout_margin="4dp"/>
                    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/img_23" android:scaleType="centerCrop" android:layout_margin="4dp"/>
                    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/img_24" android:scaleType="centerCrop" android:layout_margin="4dp"/>
                    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/img_25" android:scaleType="centerCrop" android:layout_margin="4dp"/>
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Style Preferences -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Style Preferences"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"
                    android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Modern fit\n• Single-breasted\n• Two-button closure\n• Peak lapels"
                    android:textSize="15sp"
                    android:textColor="#343C56"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Timeline & Budget -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timeline"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="8dp"
                    android:text="Desired completion: February 15, 2024"
                    android:textSize="15sp"
                    android:textColor="#343C56"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_wallet"
                    android:drawablePadding="8dp"
                    android:text="Approximate: ₹800-1000"
                    android:textSize="15sp"
                    android:textColor="#343C56"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Delivery Method & Address -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Method"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pickup at store"
                    android:textSize="15sp"
                    android:textColor="#343C56"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="8dp"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="123 Fashion Street\nNew York, NY 10001"
                    android:textSize="15sp"
                    android:textColor="#343C56"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Customer Information -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Information"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1C274C"
                    android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="James Wilson"
                    android:textSize="15sp"
                    android:textColor="#343C56"
                    android:drawableStart="@drawable/ic_icon"
                    android:drawablePadding="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="+1 (555) 123-4567"
                    android:textSize="15sp"
                    android:textColor="#343C56"
                    android:drawableStart="@drawable/ic_call"
                    android:drawablePadding="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="james.wilson@email.com"
                    android:textSize="15sp"
                    android:textColor="#343C56"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quoted Price and Order Actions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:background="#fff">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#F4F5F7"
                    android:hint="₹ Enter quoted price"
                    android:textColor="#1C274C"
                    android:textSize="15sp"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp"/>
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Confirm Order"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:backgroundTint="#FF2B52"
                    app:cornerRadius="8dp"/>
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Decline Order"
                    android:textAllCaps="false"
                    android:textColor="#FF2B52"
                    android:backgroundTint="#fff"
                    app:cornerRadius="8dp"
                    app:strokeColor="#FF2B52"
                    app:strokeWidth="1dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
